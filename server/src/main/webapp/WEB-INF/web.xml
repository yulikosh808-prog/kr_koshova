<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>usersServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.usersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>usersServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>sportObjectsServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.sportObjectsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>sportObjectsServlet</servlet-name>
        <url-pattern>/sportObjects</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>bookingServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.bookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>bookingServlet</servlet-name>
        <url-pattern>/booking</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>timeServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.timeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>timeServlet</servlet-name>
        <url-pattern>/time</url-pattern>
    </servlet-mapping>
</web-app>